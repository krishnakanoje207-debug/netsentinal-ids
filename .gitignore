# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Captures and datasets (large, regenerated)
*.pcap
*.pcapng
data/raw/
data/interim/
data/processed/
!tests/data/*.pcap

# Model artefacts. The model cards stay: they are the evaluated numbers.
*.onnx
# The torch exporter writes large graphs' weights beside the .onnx.
*.onnx.data
artefacts/**/*.lgb.txt
*.pkl
*.pt

# Secrets and local config
.env
# Local deployment settings. The API reads NETSENTINEL_* from the environment, and a
# laptop needs different values from the VM - a database on a different port, a
# throwaway signing key. Neither belongs in the history.
.env.local
*.key
*.pem
*.crt

# Build scratch
deliverables/_build/__pycache__/

# Replayed flow streams (regenerated by lab/replay)
lab/replay/out/

# Captures, fetched rules and sensor logs (regenerated by lab/pcaps)
lab/pcaps/out/

# Coverage data (regenerated by pytest --cov)
.coverage

# Fetched or generated on the VM (see infra/README.md): ET Open rules, and the Wazuh
# indexer's user file once its demo hashes are replaced. Certificates are covered by
# *.pem / *.key above.
infra/suricata/rules/*.rules
infra/wazuh/config/wazuh_indexer/internal_users.yml
