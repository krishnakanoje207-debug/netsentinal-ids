# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Captures and datasets (large, regenerated)
*.pcap
*.pcapng
data/raw/
data/interim/
data/processed/
!tests/data/*.pcap

# Model artefacts. The model cards stay: they are the evaluated numbers.
*.onnx
artefacts/**/*.lgb.txt
*.pkl
*.pt

# Secrets and local config
.env
# Local deployment settings. The API reads NETSENTINEL_* from the environment, and a
# laptop needs different values from the VM - a database on a different port, a
# throwaway signing key. Neither belongs in the history.
.env.local
*.key
*.pem

# Build scratch
deliverables/_build/__pycache__/

# Replayed flow streams (regenerated by lab/replay)
lab/replay/out/

# Coverage data (regenerated by pytest --cov)
.coverage
