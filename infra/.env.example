# Copy to .env on the VM and fill in. .env is gitignored; never commit real values.
#
# Generate each one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Every variable here must have a value even if you never bring its profile up.
# Compose interpolates the whole file before it decides which services a profile
# selects, so one blank MISP password stops `--profile storage` from starting
# PostgreSQL.

POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=
# Host port only. Leave it alone on the VM; change it on a laptop that already has
# something on 5432.
POSTGRES_PORT=5432

CLICKHOUSE_USER=netsentinel
CLICKHOUSE_PASSWORD=

GRAFANA_PASSWORD=

# --- intel profile ---------------------------------------------------------
# Needed even when the profile is never started. See the note above.

MISP_ADMIN_PASSWORD=
MISP_DB_PASSWORD=
MISP_DB_ROOT_PASSWORD=

# Keep generates this in its own UI on first run. Any non-empty placeholder lets
# the rest of the stack start; replace it before bringing the intel profile up.
KEEP_API_KEY=

# --- app profile -----------------------------------------------------------
# The API's token signing key. Generate it the same way as the passwords above.
NETSENTINEL_JWT_SECRET=
# What the pipeline's sensor presents to the API to read which models are active.
# Generated the same way (the API wants at least 32 characters).
NETSENTINEL_SENSOR_TOKEN=
# Which database inside PostgreSQL the API uses (netsentinel_demo for the demo).
NETSENTINEL_DB=netsentinel

# --- pipeline profile ------------------------------------------------------
# The sensors row the writer's detections belong to (README).
# How often, in seconds, Suricata's eve.json is imported into alerts.
WRITER_SENSOR_ID=1
SURICATA_IMPORT_SECONDS=300

# --- hids, case and scan profiles ------------------------------------------
# Unlike the ones above, these may stay blank until their profile is first brought
# up: compose substitutes an empty value rather than refusing, so a machine that never
# runs Wazuh or IRIS does not need them. A blank one does fail its own service.

# Wazuh. The indexer passwords must match the hashes put into
# wazuh/config/wazuh_indexer/internal_users.yml (see README). The API password must
# have upper and lower case, a digit and a symbol, or the manager rejects it.
WAZUH_INDEXER_PASSWORD=
WAZUH_DASHBOARD_PASSWORD=
WAZUH_API_PASSWORD=

# DFIR-IRIS. IRIS_ADM_API_KEY becomes NETSENTINEL_IRIS_API_KEY in the API's
# environment; generate it with python3 -c "import secrets; print(secrets.token_hex(32))".
IRIS_DB_PASSWORD=
IRIS_DB_ADMIN_PASSWORD=
IRIS_SECRET_KEY=
IRIS_SECURITY_PASSWORD_SALT=
IRIS_ADM_PASSWORD=
IRIS_ADM_API_KEY=
